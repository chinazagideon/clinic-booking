# API Security
API_KEY=koya-secret-api-key

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://clinic:clinic_secret@localhost:5432/clinic_booking

# Redis Store (Idempotency & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Idempotency TTL (seconds)
IDEMPOTENCY_TTL_SECONDS=86400
